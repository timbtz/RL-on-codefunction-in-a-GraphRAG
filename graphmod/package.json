{
  "name": "neo4j-graph-modules",
  "version": "0.1.0",
  "description": "Typed, modular graph schema system for Neo4j",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch -r dotenv/config examples/usage.ts",
    "example": "tsx -r dotenv/config examples/usage.ts",
    "visualize": "tsx visualization/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test -r dotenv/config \"tests/Module/**/*.test.ts\"",
    "test:reset": "tsx --test -r dotenv/config tests/reset.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "dotenv": "^17.4.2",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "neo4j-driver": "^5.28.3"
  }
}
