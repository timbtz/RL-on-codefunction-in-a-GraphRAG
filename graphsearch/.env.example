# graphsearch / optimizer real-run env. Copy to graphsearch/.env and fill in.
# Load before running:  set -a; source graphsearch/.env; set +a

# --- Neo4j (restored multi.video KG) ---------------------------------------
GRAPHSEARCH_NEO4J_URL=bolt://localhost:7687
GRAPHSEARCH_NEO4J_USER=neo4j
GRAPHSEARCH_NEO4J_PASSWORD=graphretrmulti
GRAPHSEARCH_NEO4J_DATABASE=multi.video

# --- OpenRouter (OpenAI-compatible) for in-search + answerer LLM calls ------
# The mutator/optimizer is NOT here — it uses the Claude CLI (subscription).
# Keep OPENAI_API_KEY and ANTHROPIC_API_KEY UNSET so routing/mutator stay correct.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model ids (OpenRouter slugs — verify exact slugs on openrouter.ai/models):
#   in-search / keyword extraction / usefulness judging  -> Gemini 2.5 Flash Lite
#   MCQ answerer                                          -> DeepSeek V3
SEARCH_MODEL=google/gemini-2.5-flash-lite
ANSWERER_MODEL=deepseek/deepseek-chat

# --- MLflow (UI server already runs under uvx py3.12 on :5000) --------------
# Default cfg.mlflow_url is http://127.0.0.1:5000, so no override is needed.
